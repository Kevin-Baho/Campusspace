# Tambahkan/ubah di .env (JANGAN commit .env). Isi nilai asli dari TiDB Cloud & Groq Console.
APP_NAME=CampusSpace
APP_TIMEZONE=Asia/Jakarta   # = zona waktu kampus (dipakai untuk aturan "hari ini" & check-in)
APP_LOCALE=id

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=4000
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# TLS TiDB Cloud (wajib). Lokal Linux: /etc/ssl/certs/ca-certificates.crt ; macOS: /etc/ssl/cert.pem
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

SESSION_DRIVER=database
CACHE_STORE=database

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CRON_SECRET=            # string acak panjang; dipakai Vercel Cron (Authorization: Bearer)
